                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1.06" frame="9" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.985" frame="22" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="36"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.94" frame="9" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1.02" frame="22" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="36"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Slump (error, annoyed): sunk a little, leaning. -->
        <LinearAnimation loopValue="pingPong" duration="110" name="Body slump" id="0:804">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.03" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
