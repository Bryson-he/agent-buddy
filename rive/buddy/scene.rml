                <AnimationState x="460" y="-200" animationId="0:306" id="0:506"/>
                <AnimationState x="460" y="-120" animationId="0:307" id="0:507"/>
                <AnimationState x="460" y="-40" animationId="0:308" id="0:508"/>
                <AnimationState x="460" y="40" animationId="0:309" id="0:509"/>
                <AnimationState x="460" y="120" animationId="0:310" id="0:510"/>
            </StateMachineLayer>

            <!-- Which part of each eye shows. Most states use the plain pill. -->
            <StateMachineLayer name="Symbol" id="0:10">
                <ExitState x="900" y="-140"/>
                <EntryState x="-160" y="0"><StateTransition stateToId="0:700"/></EntryState>
                <AnyState x="-160" y="200">
                    <StateTransition stateToId="0:700" duration="180"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="0"/></TransitionViewModelCondition></StateTransition>
