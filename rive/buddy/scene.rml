        <!-- ================= Shape layer: each shows one body ================= -->
        <LinearAnimation duration="1" name="Shape ball" id="2:100"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:100" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape cloud" id="2:101"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:101" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape square" id="2:102"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:102" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape sparkle" id="2:103"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:103" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape clover" id="2:104"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:104" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape drop" id="2:105"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:105" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape burst" id="2:106"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:106" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape egg" id="2:107"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:107" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape pill" id="2:108"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:108" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape triangle" id="2:109"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:109" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape house" id="2:110"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:110" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape star" id="2:111"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:111" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>
        <LinearAnimation duration="1" name="Shape hex" id="2:112"><KeyedObject objectId="0:50"><KeyedProperty property="activeComponentId"><KeyFrameId value="1:112" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject></LinearAnimation>

        <!-- ================= Body layer =================
             Each keys the rig's rotation, scaleX and scaleY, and nothing else: it stays where it stands.
             pingPong plays there and back, so two keys make a seamless loop. -->

        <!-- Breathe (idle): the faintest squish. -->
        <LinearAnimation loopValue="pingPong" duration="100" name="Body breathe" id="0:800">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1.014" frame="100"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.986" frame="100"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Sway (working, greeting): leaning gently side to side. -->
        <LinearAnimation loopValue="pingPong" duration="72" name="Body sway" id="0:801">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.04" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.04" frame="72"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX"><KeyFrameDouble value="1" frame="0"/></KeyedProperty>
                <KeyedProperty property="scaleY"><KeyFrameDouble value="1" frame="0"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Pulse (needs you, upload): a soft, regular squish. -->
        <LinearAnimation loopValue="pingPong" duration="34" name="Body pulse" id="0:802">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1.03" frame="34"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.97" frame="34"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Settle (finished): one soft squish, then an easy sway. -->
        <LinearAnimation loopValue="loop" duration="220" name="Body settle" id="0:803">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0" frame="36" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.04" frame="96" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.04" frame="164" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="220"/>
