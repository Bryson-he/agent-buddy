                    <KeyFrameDouble value="0.95" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.975" frame="140"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Squish (slap): pressed flat for a moment, then back. Plays once. -->
        <LinearAnimation duration="32" name="Body squish" id="0:806">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation"><KeyFrameDouble value="0" frame="0"/></KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1.13" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
