                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.87" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1.03" frame="11" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.99" frame="21" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="32"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Wobble (dizzy): a wider sway. -->
        <LinearAnimation loopValue="pingPong" duration="42" name="Body wobble" id="0:807">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation">
