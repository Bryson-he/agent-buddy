                    <KeyFrameDouble value="0.93" frame="0" interpolationType="cubic"><CubicEaseInterpolator/></KeyFrameDouble>
                    <KeyFrameDouble value="0.92" frame="110"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Doze: slow, deep breathing, leaning to one side. -->
        <LinearAnimation loopValue="pingPong" duration="140" name="Body doze" id="0:805">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="rotation"><KeyFrameDouble value="0.08" frame="0"/></KeyedProperty>
                <KeyedProperty property="scaleX">
