                </AnyState>
                <AnimationState x="160" y="-200" animationId="0:800" id="0:900"/>
                <AnimationState x="160" y="-120" animationId="0:801" id="0:901"/>
                <AnimationState x="160" y="-40" animationId="0:802" id="0:902"/>
                <AnimationState x="160" y="40" animationId="0:803" id="0:903"/>
                <AnimationState x="160" y="120" animationId="0:804" id="0:904"/>
                <AnimationState x="460" y="-200" animationId="0:805" id="0:905"/>
                <AnimationState x="460" y="-120" animationId="0:806" reset="true" id="0:906"/>
                <AnimationState x="460" y="-40" animationId="0:807" id="0:907"/>
            </StateMachineLayer>

            <StateMachineLayer name="Face" id="0:9">
                <ExitState x="900" y="-140"/>
                <EntryState x="-160" y="0"><StateTransition stateToId="0:500"/></EntryState>
                <AnyState x="-160" y="200">
                    <StateTransition stateToId="0:500" duration="220"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="0"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:501" duration="220"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="1"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:502" duration="140"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="2"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:503" duration="160"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="3"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:504" duration="140"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="4"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:505" duration="220"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="5"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:506" duration="200"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="6"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:507" duration="700"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="7"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:508" duration="160"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="8"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:509" duration="40"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="9"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:510" duration="200"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="10"/></TransitionViewModelCondition></StateTransition>
                </AnyState>
                <AnimationState x="160" y="-200" animationId="0:300" id="0:500"/>
