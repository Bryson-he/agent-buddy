<Rive version="1" kind="fragment">
    <!--
        Agent Buddy's main character.

        The host app drives it through the "Buddy" view model:
          color   the agent's colour
          lookX   -1..1, where the eyes look (left..right)
          lookY   -1..1, (up..down)
          shape   0 ball, 1 cloud, 2 square, 3 sparkle, 4 clover, 5 drop, 6 burst, 7 egg,
                  8 pill, 9 triangle, 10 house, 11 star, 12 hex
          state   0 idle, 1 working, 2 needsYou, 3 finished, 4 error, 5 upload,
                  6 greeting, 7 doze, 8 annoyed, 9 slap, 10 dizzy

        The body only ever squishes and sways a little, in place: no bouncing,
        no travelling. The expression is in the eyes and the colour.
        Three layers run side by side: "Body" (a gentle squish or sway), "Face" (where the eyes sit, the pill's tilt
        and size, blinking, and the colour wash) and "Symbol" (which part of
        each eye shows: the pill, a spinning ring while working, an X on error).
        Every animation in a layer keys the same set of properties, so changing
        state always blends every one of them and nothing is left where the
        last state put it.

        Draw order: the first sibling is in front.
    -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" viewModelId="0:100" viewModelInstanceId="0:110" width="200" height="200" name="Buddy" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- The rig pivots at the feet, so squash and stretch stay planted on the ground. -->
        <Node x="100" y="166" name="Rig" id="0:20">
            <!-- Where the eyes look: moved by lookX / lookY. -->
            <Node x="0" y="-64" name="Look" id="0:30">
                <DataBindContext sourcePathIds="0:100-0:102" propertyKey="13" converterId="0:120"/>
                <DataBindContext sourcePathIds="0:100-0:103" propertyKey="14" converterId="0:121"/>
                <Node name="Eyes" id="0:31">
                    <!-- Each eye is a group of three parts that fade between each other:
                         the pill (the normal eye), a second bar (crossed with the pill it
                         makes an X), and a ring with a gap (spun, it is a loading symbol). -->
                    <Node x="-21" name="Eye L" id="0:32">
                        <Shape opacity="0" name="Ring L" id="0:38">
                            <Ellipse width="27" height="27" name="Path"/>
                            <Stroke thickness="8" cap="round" name="Stroke">
                                <SolidColor colorValue="FF15161A" name="Color"/>
                                <TrimPath start="0" end="0.72" name="Trim"/>
                            </Stroke>
                        </Shape>
                        <Shape opacity="0" rotation="-0.7853982" name="Bar L" id="0:36">
                            <Rectangle width="30" height="9" cornerRadiusTL="5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF15161A" name="Color"/></Fill>
                        </Shape>
                        <Shape name="Pill L" id="0:44">
                            <Rectangle width="16" height="34" cornerRadiusTL="9" name="Path" id="0:33"/>
                            <Fill name="Fill"><SolidColor colorValue="FF15161A" name="Color"/></Fill>
                        </Shape>
                    </Node>
                    <Node x="21" name="Eye R" id="0:34">
                        <Shape opacity="0" name="Ring R" id="0:39">
                            <Ellipse width="27" height="27" name="Path"/>
                            <Stroke thickness="8" cap="round" name="Stroke">
                                <SolidColor colorValue="FF15161A" name="Color"/>
                                <TrimPath start="0" end="0.72" name="Trim"/>
                            </Stroke>
                        </Shape>
                        <Shape opacity="0" rotation="-0.7853982" name="Bar R" id="0:37">
                            <Rectangle width="30" height="9" cornerRadiusTL="5" name="Path"/>
                            <Fill name="Fill"><SolidColor colorValue="FF15161A" name="Color"/></Fill>
                        </Shape>
                        <Shape name="Pill R" id="0:45">
                            <Rectangle width="16" height="34" cornerRadiusTL="9" name="Path" id="0:35"/>
                            <Fill name="Fill"><SolidColor colorValue="FF15161A" name="Color"/></Fill>
                        </Shape>
                    </Node>
                </Node>
            </Node>

            <!-- A small soft highlight, top left: makes the ball read as glossy. -->
            <Shape x="-24" y="-98" rotation="-0.6" name="Highlight">
                <ClippingShape sourceId="0:50" name="Clip to body"/>
                <Ellipse width="34" height="16" name="Path"/>
                <Fill fillRule="clockwise" name="Fill">
                    <SolidColor colorValue="8CFFFFFF" name="Color"/>
                    <Feather strength="9" name="Feather"/>
                </Fill>
            </Shape>

            <!-- State colour rising from the bottom: blue while working, red on error. -->
            <Shape y="-62" opacity="0" name="Wash" id="0:40">
                <ClippingShape sourceId="0:50" name="Clip to body"/>
                <Ellipse width="150" height="150" name="Path"/>
                <Fill name="Fill">
                    <LinearGradient startX="0" startY="66" endX="0" endY="-26" name="Gradient">
                        <GradientStop colorValue="F23B9BFF" position="0" id="0:41"/>
                        <GradientStop colorValue="003B9BFF" position="1" id="0:42"/>
                    </LinearGradient>
                </Fill>
            </Shape>

            <!-- Light from the top left, shadow towards the bottom right. -->
            <Shape y="-62" name="Shade">
                <ClippingShape sourceId="0:50" name="Clip to body"/>
                <Ellipse width="150" height="150" name="Path"/>
                <Fill name="Fill">
                    <RadialGradient startX="-22" startY="-28" endX="92" endY="-28" name="Gradient">
                        <GradientStop colorValue="A6FFFFFF" position="0"/>
                        <GradientStop colorValue="00FFFFFF" position="0.42"/>
                        <GradientStop colorValue="5C000000" position="1"/>
                    </RadialGradient>
                </Fill>
            </Shape>

            <!-- The body. Its colour comes from the view model. -->
            <!-- The body: one of thirteen shapes, chosen by the view model's "shape" number (the
                 Shape layer switches which one shows). Each takes its colour from the view model. -->
            <Solo y="-62" activeComponentId="1:100" name="Body" id="0:50">
                <Shape name="Ball" id="1:100">
                    <Ellipse width="124" height="124" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Cloud" id="1:101">
                    <Star points="7" innerRadius="0.86" cornerRadius="26" width="130" height="126" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Square" id="1:102">
                    <Rectangle width="112" height="112" cornerRadiusTL="30" rotation="0.12" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Sparkle" id="1:103">
                    <Star points="4" innerRadius="0.66" cornerRadius="24" width="160" height="160" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Clover" id="1:104">
                    <Star points="5" innerRadius="0.76" cornerRadius="30" width="146" height="146" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Drop" id="1:105">
                    <Polygon points="3" cornerRadius="50" width="176" height="166" rotation="0.6" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Burst" id="1:106">
                    <Star points="9" innerRadius="0.84" cornerRadius="12" width="130" height="130" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Egg" id="1:107">
                    <Ellipse width="106" height="128" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Pill" id="1:108">
                    <Rectangle width="134" height="98" cornerRadiusTL="49" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Triangle" id="1:109">
                    <Polygon points="3" cornerRadius="34" width="172" height="160" y="-8" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="House" id="1:110">
                    <Polygon points="5" cornerRadius="26" width="140" height="138" y="2" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Star" id="1:111">
                    <Star points="6" innerRadius="0.7" cornerRadius="14" width="136" height="136" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
                <Shape name="Hex" id="1:112">
                    <Polygon points="6" cornerRadius="22" width="130" height="130" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFF3F3F1" name="Color"><DataBindContext sourcePathIds="0:100-0:101" propertyKey="37"/></SolidColor></Fill>
                </Shape>
            </Solo>
        </Node>

        <!-- Ground shadow: stays put while the body bounces. -->
        <Shape x="100" y="170" name="Ground shadow" id="0:60">
            <Ellipse width="92" height="14" name="Path"/>
            <Fill fillRule="clockwise" name="Fill">
                <SolidColor colorValue="73000000" name="Color"/>
                <Feather strength="8" name="Feather"/>
            </Fill>
        </Shape>

        <StateMachine name="Buddy" id="0:7">
            <!-- Which body shape shows. -->
            <StateMachineLayer name="Shape" id="0:12">
                <ExitState x="900" y="-140"/>
                <EntryState x="-160" y="0"><StateTransition stateToId="3:100"/></EntryState>
                <AnyState x="-160" y="200">
                    <StateTransition stateToId="3:100" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="0"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:101" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="1"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:102" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="2"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:103" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="3"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:104" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="4"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:105" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="5"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:106" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="6"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:107" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="7"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:108" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="8"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:109" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="9"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:110" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="10"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:111" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="11"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="3:112" duration="0"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:105" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="12"/></TransitionViewModelCondition></StateTransition>
                </AnyState>
                <AnimationState x="160" y="-200" animationId="2:100" id="3:100"/>
                <AnimationState x="310" y="-200" animationId="2:101" id="3:101"/>
                <AnimationState x="460" y="-200" animationId="2:102" id="3:102"/>
                <AnimationState x="610" y="-200" animationId="2:103" id="3:103"/>
                <AnimationState x="760" y="-200" animationId="2:104" id="3:104"/>
                <AnimationState x="160" y="-120" animationId="2:105" id="3:105"/>
                <AnimationState x="310" y="-120" animationId="2:106" id="3:106"/>
                <AnimationState x="460" y="-120" animationId="2:107" id="3:107"/>
                <AnimationState x="610" y="-120" animationId="2:108" id="3:108"/>
                <AnimationState x="760" y="-120" animationId="2:109" id="3:109"/>
                <AnimationState x="160" y="-40" animationId="2:110" id="3:110"/>
                <AnimationState x="310" y="-40" animationId="2:111" id="3:111"/>
                <AnimationState x="460" y="-40" animationId="2:112" id="3:112"/>
            </StateMachineLayer>

            <!-- A little life in the body: squish and sway in place, never a bounce. -->
            <StateMachineLayer name="Body" id="0:11">
                <ExitState x="900" y="-140"/>
                <EntryState x="-160" y="0"><StateTransition stateToId="0:900"/></EntryState>
                <AnyState x="-160" y="200">
                    <StateTransition stateToId="0:900" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="0"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:901" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="1"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:902" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="2"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:903" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="3"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:904" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="4"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:902" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="5"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:901" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="6"/></TransitionViewModelCondition></StateTransition>
                    <StateTransition stateToId="0:905" duration="320"><TransitionViewModelCondition><TransitionPropertyViewModelComparator><BindablePropertyNumber><DataBindContext sourcePathIds="0:100-0:104" propertyKey="636"/></BindablePropertyNumber></TransitionPropertyViewModelComparator><TransitionValueNumberComparator value="7"/></TransitionViewModelCondition></StateTransition>
