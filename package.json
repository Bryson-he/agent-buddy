{
  "name": "agent-buddy",
  "version": "0.8.0",
  "private": true,
  "description": "A Windows desktop companion that shows what your AI agents (Claude Code, Cursor, Grok Bot, anything with MCP) are doing and asks you when one needs you.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "test": "npm run build && node scripts/test-grok-loop.mjs",
    "test:smoke-grok": "node scripts/smoke-ask-grok.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.agentbuddy.app",
    "productName": "Agent Buddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "docs/**/*",
      "connectors/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "connectors/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "AgentBuddy-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Buddy",
      "deleteAppDataOnUninstall": false
    },
    "extraMetadata": {
      "main": "dist/main/main.js"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@rive-app/webgl2": "^2.55.1",
    "@types/node": "^22.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "electron@39.8.10": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bryson-he/agent-buddy.git"
  },
  "homepage": "https://github.com/Bryson-he/agent-buddy#readme",
  "keywords": [
    "ai-agents",
    "mcp",
    "claude-code",
    "cursor",
    "grok",
    "electron",
    "windows",
    "desktop-companion"
  ]
}
